# Copy to .env. The store endpoint and token you got at sign-up:
STORE_API_URL=https://<host>/api/v1/stores/<your-store>
STORE_API_TOKEN=<your token>
# Optional (defaults shown)
# DATABASE_URL=sqlite:///storecloud.db
# POLL_INTERVAL_SECONDS=5
# OFFLINE_AFTER_SECONDS=30
# ALARM_ABOVE_C=-15
# DEFROST_ALARM_ABOVE_C=0
